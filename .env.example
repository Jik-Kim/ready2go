# 장비별 값 — 복사해서 .env 로 사용 (Git 제외)
BACKEND=mock            # real | sim | mock
VISION_MODE=yolo        # yolo | yolo_sam2 | oracle(sim 전용)
ROBOT_HOST=127.0.0.1    # real: 실물 제어기 IP [팀 확정 필요]
DDS_MODE=local          # local(강사 원본, 단일 PC) | multi(다중 PC)
DDS_IFACE=              # multi: 팀 공유기 쪽 NIC 이름
PEER_PC1=               # multi: PC1 IP
PEER_PC2=               # multi: PC2 IP
