# 장비별 값 — 복사해서 .env 로 사용 (Git 제외)
BACKEND=mock            # real | sim | mock
VISION_MODE=yolo        # yolo | yolo_sam2 | oracle(sim 전용)
ROBOT_HOST=127.0.0.1    # real: 실물 제어기 IP [팀 확정 필요]
RG2_HOST=192.168.1.1    # real: RG2(Compute Box) Modbus IP [실측 10/03, B]
DDS_MODE=local          # local(강사 원본, 단일 PC) | multi(다중 PC)
DDS_IFACE=              # multi: 팀 공유기 쪽 NIC 이름
PEER_PC1=               # multi: PC1 IP
PEER_PC2=               # multi: PC2 IP
MOCK_FAIL=               # mock: 실패 시험 (예: pick_object=GRASP_FAILED*1, 처음 1번만 실패)
MOCK_NOT_VISIBLE=        # mock: inspect_region 에서 못 찾을 물품 (예: car_key)
RUNNER_TASK_FILE=        # 시험용: 시작할 때 한 번 실행할 태스크 (예: /contracts/examples/task_skill_steps.json)
RUNNER_ONTOLOGY_FILE=/knowledge/robot_ontology.jsonld   # 다른 온톨로지로 띄울 때만 (예: 시연용 robot_ontology_demo.jsonld). P1(#118)은 기본 그대로
RUNNER_INTENT_TASKS=     # P1 음성 시연: find_item=/tasks/p1_demo_eraser.json (인텐트=태스크, trigger.intent 보다 우선)
