{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskSequence",
  "type": "object",
  "required": ["task_id", "sequence"],
  "properties": {
    "task_id": { "type": "string" },
    "description": { "type": "string" },
    "inputs": { "type": "object", "description": "음성 인텐트에서 바인딩되는 입력 (예: target, list_name)" },
    "trigger": {
      "type": "object",
      "description": "태스크 레지스트리용 음성 트리거 (7.6)",
      "properties": {
        "intent": { "type": "string", "description": "이 태스크를 실행하는 /voice/intent 의 intent (예: find_item)" },
        "targets": {
          "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true,
          "description": "받을 물품 키 목록(선택). 있으면 이 물품만 실행하고 나머지는 UNSUPPORTED_ITEM 보류 (runner.md 7.1)"
        }
      }
    },
    "params": { "type": "object", "description": "복합 스킬 입력 선언 (이름: 클래스)" },
    "pre": { "type": "object", "description": "실행 조건 (상태 경로: 값, 7.5)" },
    "effect": { "description": "결과 (상태 경로: 값) 또는 \"sensing\"" },
    "sequence": { "type": "array", "items": { "$ref": "#/definitions/step" } },
    "finally":  { "type": "array", "items": { "$ref": "#/definitions/step" } },
    "on_halt":  { "type": "array", "items": { "$ref": "#/definitions/step" } }
  },
  "definitions": {
    "cond": {
      "type": "object",
      "required": ["op", "args"],
      "properties": {
        "op": { "enum": ["==", "!=", "<", ">", "<=", ">=", "and", "or", "not", "empty", "not_empty"] },
        "args": { "type": "array", "minItems": 1 }
      }
    },
    "step": {
      "type": "object",
      "required": ["id"],
      "oneOf": [
        { "required": ["action"], "not": { "required": ["skill"] } },
        { "required": ["skill"], "not": { "required": ["action"] } }
      ],
      "properties": {
        "id": { "type": "string", "description": "로그 추적용 고유 ID (예: s7, s7.1)" },
        "action": { "enum": [
          "move_to_named_pose", "drawer_control", "inspect_region", "nudge_object", "pick_object", "place_object",
          "query_ontology", "update_ontology", "select_obstacle", "find_moved", "speak",
          "set_var", "push", "pop", "if", "while", "for_each", "fallback"
        ]},
        "skill": { "type": "string", "description": "온톨로지 primitive 스킬 이름 (예: open_drawer). Runner 가 pre 확인 → expand 실행 → effect 반영 (#12). action 과 함께 쓰지 않음" },
        "params": { "type": "object", "description": "원자 동작 파라미터, 또는 skill 스텝이면 온톨로지 스킬 파라미터(예: pick 의 item·from). $변수 사용 가능" },
        "output": { "type": "string", "description": "반환값을 저장할 변수명" },
        "cond": { "$ref": "#/definitions/cond" },
        "then": { "type": "array", "items": { "$ref": "#/definitions/step" } },
        "else": { "type": "array", "items": { "$ref": "#/definitions/step" } },
        "body": { "type": "array", "items": { "$ref": "#/definitions/step" } },
        "in":   { "type": "string" },
        "as":   { "type": "string" },
        "max_iter": { "type": "integer", "minimum": 1 },
        "on_failure": { "enum": ["abort", "retry", "skip", "safe_home"], "default": "abort" },
        "timeout_sec": { "type": "number", "exclusiveMinimum": 0 },
        "recovery": { "type": "array", "items": { "$ref": "#/definitions/step" } },
        "options": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/definitions/step" } } },
        "next_on": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "fallback 전용 (#121·#245 계약, E 대화 승인 10/13, 사용자 전달 — #263): 앞 대안이 로봇을 움직이지 않고 이 코드 중 하나로 실패했을 때만 다음 대안. 없으면 움직이지 않은 실패면 다음 대안(기존). 스킬 expand 안 fallback 은 필수" },
        "retry": { "type": "integer", "minimum": 0, "default": 0 }
      }
    }
  }
}
