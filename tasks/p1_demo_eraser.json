{
  "task_id": "p1_demo_eraser",
  "description": "말 없는 예비 태스크 (P1 기준 아님 — P1 은 tasks/find_item.json, E #17 10/07): 지우개를 위 서랍 벽에 붙여 둠 → 위치 조회 → 스킬 open_drawer → 공통 스킬 pick (E #122: 탑뷰 → inspect_region → nudge_object 로 옆(y)으로 끌기 → 탑뷰 → inspect_region 다시 → 다시 본 좌표로 pick_object. FR-ACT-05 재인식, 못 찾으면 VAR_NULL 로 pick 안 보냄) → 스킬 place(handover_zone) → finally 그리퍼 상태 조회·close_drawer(skip)·그리퍼가 비어 있을 때만 홈. 공통 온톨로지(knowledge/robot_ontology.jsonld)로 실행. speak 없음. 끌기 뒤 스킬 재시도 없음(Runner MOTION_UNCERTAIN)",
  "trigger": {
    "targets": [
      "eraser"
    ]
  },
  "inputs": {
    "target": "eraser"
  },
  "sequence": [
    {
      "id": "s1",
      "action": "query_ontology",
      "params": {
        "item": "$inputs.target"
      },
      "output": "loc"
    },
    {
      "id": "s2",
      "skill": "open_drawer",
      "params": {
        "drawer_id": "$loc.drawer_id"
      },
      "timeout_sec": 60
    },
    {
      "id": "s3",
      "skill": "pick",
      "params": {
        "item": "$inputs.target",
        "from": "$loc.drawer_id"
      },
      "timeout_sec": 70
    },
    {
      "id": "s4",
      "skill": "place",
      "params": {
        "item": "$inputs.target",
        "to": "handover_zone"
      },
      "timeout_sec": 60
    }
  ],
  "finally": [
    {
      "id": "f1",
      "action": "query_ontology",
      "params": {
        "state": "gripper.robot"
      },
      "output": "hold"
    },
    {
      "id": "f2",
      "skill": "close_drawer",
      "params": {
        "drawer_id": "$loc.drawer_id"
      },
      "on_failure": "skip",
      "timeout_sec": 60
    },
    {
      "id": "f3",
      "action": "if",
      "cond": {
        "op": "==",
        "args": [
          "$hold.value",
          "empty"
        ]
      },
      "then": [
        {
          "id": "f3.1",
          "action": "move_to_named_pose",
          "params": {
            "pose_name": "home"
          },
          "timeout_sec": 60
        }
      ],
      "else": [
        {
          "id": "f3.2",
          "action": "set_var",
          "params": {
            "name": "stopped_holding",
            "value": "물품을 쥔 채 정지 — 홈 이동 안 함, 사람 복구 (PR #82 리뷰)"
          }
        }
      ]
    }
  ]
}
