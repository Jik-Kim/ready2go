                "tol_m": "$inputs.reid_tol_m"
              },
              "output": "found"
            },
            {
              "id": "fr.5",
              "action": "if",
              "cond": {
                "op": "==",
                "args": [
                  "$found.status",
                  "found"
                ]
              },
              "then": [
                {
                  "id": "fr.5.0z",
                  "action": "set_var",
                  "params": {
                    "name": "restore_plan",
                    "value": "none"
                  }
                },
                {
                  "id": "fr.5.0",
                  "action": "fallback",
                  "on_failure": "skip",
                  "options": [
                    [
                      {
                        "id": "fr.5.0a",
                        "action": "place_object",
                        "timeout_sec": 30,
                        "params": {
                          "location": "$loc.drawer_id",
                          "pose": "$item.origin",
                          "scan": "$rescan",
                          "object": "$found.object",
                          "check_only": true
                        }
                      },
                      {
                        "id": "fr.5.0k",
                        "action": "set_var",
                        "params": {
                          "name": "restore_plan",
                          "value": "origin"
                        }
                      }
                    ],
                    [
                      {
                        "id": "fr.5.0b",
                        "action": "place_object",
                        "timeout_sec": 30,
                        "params": {
                          "location": "$loc.drawer_id",
                          "slot": "$item.slot",
                          "scan": "$rescan",
                          "object": "$found.object",
                          "check_only": true
                        }
                      },
                      {
                        "id": "fr.5.0l",
                        "action": "set_var",
                        "params": {
                          "name": "restore_plan",
                          "value": "aside"
                        }
                      }
                    ]
                  ]
                },
                {
                  "id": "fr.5.c",
                  "action": "if",
                  "cond": {
                    "op": "==",
                    "args": [
                      "$restore_plan",
                      "origin"
                    ]
                  },
                  "then": [
                    {
                      "id": "fr.5.1",
                      "action": "pick_object",
                      "params": {
                        "target": "$found.object",
                        "scan": "$rescan"
                      },
                      "timeout_sec": 60
                    },
                    {
                      "id": "fr.5.2",
                      "action": "set_var",
                      "params": {
                        "name": "holding",
                        "value": true
                      }
                    },
                    {
                      "id": "fr.5.3",
                      "action": "fallback",
                      "options": [
                        [
                          {
                            "id": "fr.5.3a",
                            "action": "place_object",
                            "timeout_sec": 60,
                            "params": {
                              "location": "$loc.drawer_id",
                              "pose": "$item.origin",
                              "scan": "$rescan"
                            }
                          },
                          {
                            "id": "fr.5.3r",
                            "action": "push",
                            "params": {
                              "stack": "restored",
                              "value": "$item"
                            }
                          },
                          {
                            "id": "fr.5.3k",
                            "action": "set_var",
                            "params": {
                              "name": "restore_ok",
                              "value": true
                            }
                          }
                        ],
                        [
                          {
                            "id": "fr.5.3b",
                            "action": "place_object",
                            "timeout_sec": 60,
                            "params": {
                              "location": "$loc.drawer_id",
                              "slot": "$item.slot",
                              "scan": "$rescan"
                            }
                          },
                          {
                            "id": "fr.5.3l",
                            "action": "push",
                            "params": {
                              "stack": "left_aside",
                              "value": {
                                "class": "$item.class",
                                "slot": "$item.slot"
                              }
                            }
                          },
                          {
                            "id": "fr.5.3m",
                            "action": "set_var",
                            "params": {
                              "name": "restore_ok",
                              "value": true
                            }
                          }
                        ]
                      ]
                    },
                    {
                      "id": "fr.5.4",
                      "action": "set_var",
                      "params": {
                        "name": "holding",
                        "value": false
                      }
                    }
                  ]
                },
                {
                  "id": "fr.5.d",
                  "action": "if",
                  "cond": {
                    "op": "==",
                    "args": [
                      "$restore_plan",
                      "aside"
                    ]
                  },
                  "then": [
                    {
                      "id": "fr.5.l",
                      "action": "push",
                      "params": {
                        "stack": "left_aside",
                        "value": {
                          "class": "$item.class",
                          "slot": "$item.slot"
                        }
                      }
                    },
                    {
                      "id": "fr.5.m",
                      "action": "set_var",
                      "params": {
                        "name": "restore_ok",
                        "value": true
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "fr.x",
          "action": "if",
          "cond": {
            "op": "==",
            "args": [
              "$restore_ok",
              false
            ]
          },
          "then": [
            {
              "id": "fr.x1",
              "action": "push",
              "params": {
                "stack": "restore_failed",
                "value": {
                  "class": "$item.class",
                  "slot": "$item.slot"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "fv",
      "action": "if",
      "on_failure": "skip",
      "cond": {
        "op": "and",
        "args": [
          {
            "op": "not_empty",
            "args": [
              "$restored"
            ]
          },
          {
            "op": "==",
            "args": [
              "$holding",
              false
            ]
          },
          {
            "op": "==",
            "args": [
              "$hold.value",
              "empty"
            ]
          }
        ]
      },
      "then": [
        {
          "id": "fv.1",
          "action": "move_to_named_pose",
          "on_failure": "skip",
          "timeout_sec": 60,
          "params": {
            "pose_name": "drawer_top_view",
            "drawer_id": "$loc.drawer_id"
          }
        },
        {
          "id": "fv.2",
          "action": "inspect_region",
          "on_failure": "skip",
          "timeout_sec": 30,
          "params": {
            "region": "$loc.drawer_id"
          },
          "output": "final_scan"
        },
        {
          "id": "fv.3",
          "action": "for_each",
          "on_failure": "skip",
          "in": "$restored",
          "as": "r",
          "body": [
            {
              "id": "fv.3.1",
              "action": "find_moved",
              "on_failure": "skip",
              "params": {
                "scan": "$final_scan",
                "record": {
                  "class": "$r.class",
                  "origin": "$r.origin",
                  "placed": "$r.origin"
                },
                "tol_m": "$inputs.restore_check_tol_m"
              },
              "output": "restore_check"
            }
          ]
        }
      ]
    },
    {
      "id": "fa",
      "action": "for_each",
      "on_failure": "skip",
      "in": "$left_aside",
      "as": "aside",
      "body": [
        {
          "id": "fa.1",
          "action": "query_ontology",
          "params": {
            "item": "$aside.class"
          },
          "output": "aside_item",
          "on_failure": "skip"
        },
        {
          "id": "fa.2",
          "action": "speak",
          "params": {
            "text": "{{aside_item.name_ko|은}} 원래 자리 대신 옆 빈 자리에 뒀어요"
          },
          "on_failure": "skip",
          "timeout_sec": 20
        }
      ]
    },
    {
      "id": "fn",
      "action": "if",
      "on_failure": "skip",
      "cond": {
        "op": "and",
        "args": [
          {
            "op": "or",
            "args": [
              {
                "op": "not_empty",
                "args": [
                  "$restore_stack"
                ]
              },
              {
                "op": "not_empty",
                "args": [
                  "$restore_failed"
                ]
              }
            ]
          },
          {
            "op": "==",
            "args": [
              "$holding",
              false
            ]
          }
        ]
      },
      "then": [
        {
          "id": "fn.1",
          "action": "speak",
          "on_failure": "skip",
          "timeout_sec": 20,
          "params": {
            "text": "옮긴 물건 일부를 원래 자리로 못 돌려놨어요. 사람이 확인해 주세요"
          }
        }
      ]
    },
    {
      "id": "fh",
      "action": "if",
      "on_failure": "skip",
      "cond": {
        "op": "==",
        "args": [
          "$holding",
          true
        ]
      },
      "then": [
        {
          "id": "fh.1",
          "action": "speak",
          "on_failure": "skip",
          "timeout_sec": 20,
          "params": {
            "text": "물건을 옮기다 멈췄어요. 사람이 확인해 주세요"
          }
        }
      ]
    },
    {
      "id": "fc",
      "action": "if",
      "on_failure": "skip",
      "cond": {
        "op": "==",
        "args": [
          "$holding",
          false
        ]
      },
      "then": [
        {
          "id": "f1d",
          "action": "query_ontology",
          "params": {
            "state": "open.{{loc.drawer_id}}"
          },
          "output": "drawer_before",
          "on_failure": "skip"
        },
        {
          "id": "f2",
          "skill": "close_drawer",
          "params": {
            "drawer_id": "$loc.drawer_id"
          },
          "on_failure": "skip",
          "timeout_sec": 60
        },
        {
          "id": "f2d",
          "action": "query_ontology",
          "params": {
            "state": "open.{{loc.drawer_id}}"
          },
          "output": "drawer_after",
          "on_failure": "skip"
        },
        {
          "id": "f2s",
          "action": "if",
          "on_failure": "skip",
          "cond": {
            "op": "and",
            "args": [
              {
                "op": "==",
                "args": [
                  "$drawer_before.value",
                  true
                ]
              },
              {
                "op": "==",
                "args": [
                  "$drawer_after.value",
                  false
                ]
              }
            ]
          },
          "then": [
            {
              "id": "f2s.1",
              "action": "speak",
              "params": {
                "text": "서랍을 닫았어요"
              },
              "on_failure": "skip",
              "timeout_sec": 20
            }
          ]
        }
      ],
      "else": [
        {
          "id": "fc.1",
          "action": "set_var",
          "params": {
            "name": "stopped_holding",
            "value": "장애물을 쥔 채 정지 — 서랍 닫기·홈 이동 안 함, 사람이 그리퍼 열고 회수 후 reset_state (#168 S-17)"
          }
        }
      ]
    },
    {
      "id": "f3g",
      "action": "if",
      "cond": {
        "op": "==",
        "args": [
          "$announce_pending",
          false
        ]
      },
      "then": [
        {
          "id": "f3",
          "action": "if",
          "cond": {
            "op": "and",
            "args": [
              {
                "op": "==",
                "args": [
                  "$hold.value",
                  "empty"
                ]
              },
              {
                "op": "==",
                "args": [
                  "$holding",
                  false
                ]
              }
            ]
          },
          "then": [
            {
              "id": "f3.1",
              "action": "move_to_named_pose",
              "params": {
                "pose_name": "home"
              },
              "timeout_sec": 60
            }
          ],
          "else": [
            {
              "id": "f3.2",
              "action": "set_var",
              "params": {
                "name": "stopped_holding",
                "value": "물품을 쥔 채 정지 — 홈 이동 안 함, 사람 복구 (PR #82 리뷰)"
              }
            }
          ]
        }
      ],
      "else": [
        {
          "id": "f3n",
          "action": "set_var",
          "params": {
            "name": "no_motion_reason",
            "value": "첫 안내(수락 TTS) 실패 — 로봇 동작 없음 (정본 수락 TTS, #249 E 리뷰 P1)"
          }
        }
      ]
    },
    {
      "id": "fe",
      "action": "if",
      "on_failure": "skip",
      "cond": {
        "op": "or",
        "args": [
          {
            "op": "not_empty",
            "args": [
              "$restore_stack"
            ]
          },
          {
            "op": "not_empty",
            "args": [
              "$restore_failed"
            ]
          }
        ]
      },
      "then": [
        {
          "id": "fe.1",
          "action": "set_var",
          "params": {
            "name": "task_error",
            "value": {
              "code": "RESTORE_INCOMPLETE",
              "step": "fr"
            }
          }
        }
      ]
    }
  ]
}
